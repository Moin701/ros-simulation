<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
<xacro:property name="wheel_width" value="0.0304" />
<xacro:property name="wheel_radius" value="0.0325" />
<xacro:property name="base_mass" value="4.6" />

<!-- Collision/inertial box aligned to the physical chassis body of the
     MicroROS-V2 / ROSMASTER-X3: 280mm x 220mm x 150mm (length x width x height).
     The chassis sits on the wheel axle plane; base_link origin is at ground level
     so the chassis body centroid is offset +Z by wheel_radius + chassis_height/2.
     Previous values (0.2924 x 0.1650 x 0.2446) were STL full-extent including
     the lidar mast tower, making the collision box far taller than the chassis body
     and causing BackUp to falsely detect floor collisions during recovery. -->
<xacro:property name="chassis_length" value="0.28"/>
<xacro:property name="chassis_width"  value="0.22"/>
<xacro:property name="chassis_height" value="0.15"/>
<xacro:property name="base_x_offset" value="0.0"/>
<xacro:property name="base_z_offset" value="${wheel_radius + chassis_height / 2.0}"/>

<xacro:macro name="base" params="prefix">
  <xacro:unless value="$(arg use_webots)">
    <link name="${prefix}base_footprint"/>
    <joint name="${prefix}base_joint" type="fixed">
      <parent link="${prefix}base_footprint"/>
      <child link="${prefix}base_link"/>
      <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
    </joint>
  </xacro:unless>
  <link name="${prefix}base_link">
    <visual>
        <geometry>
            <mesh filename="package://amr_description/meshes/chassis.stl"/>
        </geometry>
        <material name="green">
          <color rgba="0 0.7 0 1"/>
        </material>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </visual>
    <collision>
        <geometry>
            <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
        </geometry>
        <origin xyz="${base_x_offset} 0 ${base_z_offset}" rpy="0 0 0"/>
    </collision>
    <inertial>
        <origin xyz="${base_x_offset} 0 ${base_z_offset}" rpy="0 0 0"/>
        <mass value="${base_mass}"/>
        <inertia
            ixx="${(1/12) * base_mass * ((chassis_width * chassis_width) + (chassis_height * chassis_height))}" ixy="0.0" ixz="0.0"
            iyy="${(1/12) * base_mass * ((chassis_length * chassis_length) + (chassis_height * chassis_height))}" iyz="0.0"
            izz="${(1/12) * base_mass * ((chassis_length * chassis_length) + (chassis_width * chassis_width))}"/>
    </inertial>
  </link>
  <gazebo reference="${prefix}base_link">
    <visual>
        <material>
            <ambient>0 0.7 0 1</ambient>
            <diffuse>0 0.7 0 1</diffuse>
            <specular>0 0.7 0 1</specular>
        </material>
    </visual>
  </gazebo>
</xacro:macro>
</robot>
